# ==============================================================================
# DATABASE CONNECTION STRING (Drizzle ORM)
# ==============================================================================
# Local SQLite database file within the project directory (Default):
DATABASE_URL="file:./data/store.db"

# To swap to a live PostgreSQL database on any cloud server (AWS RDS, Supabase, Neon, Cloud SQL):
# DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# ==============================================================================
# GEMINI AI API KEY (Required for AI Chat, Maps Grounding, Veo, Images & Voice)
# ==============================================================================
# In AI Studio: Automatically injected into server environment at runtime.
# On Vercel / Netlify / Google Cloud Run: Add this in Project Settings > Environment Variables.
GEMINI_API_KEY=""
VITE_GEMINI_API_KEY=""

# ==============================================================================
# HOSTING & SERVER CONFIGURATION
# ==============================================================================
PORT=3000
NODE_ENV=production
APP_URL="https://your-domain.vercel.app"
